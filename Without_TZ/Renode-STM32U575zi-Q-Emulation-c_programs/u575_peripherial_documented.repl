// ==============================================================================
// STM32U575ZI-Q NUCLEO FULL PLATFORM DESCRIPTION FOR RENODE
// ==============================================================================
// Author: Nishant Thosar
// Date: Dec 9 2025.
// Description: This file describes the STM32U575ZI-Q microcontroller platform
//              for Renode emulation. It defines all peripherals, memory regions,
//              and hardware connections on the NUCLEO-U575ZI-Q development board.
//
// Platform Overview:
// - MCU: STM32U575ZI-Q (Cortex-M33 core @ 160 MHz)
// - Flash: 2MB
// - RAM: 786KB total (SRAM1: 192KB, SRAM2: 64KB, SRAM3: 512KB, SRAM4: 16KB)
// - Backup RAM: 8KB
//
// Peripheral Status:
// - Functional: CPU, UARTs (USART1-5, LPUART1), GPIOs (Ports A-I), LEDs
// - Mocked (Memory-mapped): SPI, I2C, Timers, ADC, DMA, CRC, RNG, System peripherals
//   (Mocked peripherals appear as memory regions but don't provide full functionality)
//
// Reference Documents:
// - STM32U575xx Datasheet
// - STM32U575xx Reference Manual
// - Peripheral Address Map
// ==============================================================================

// ==============================================================================
// 1. CORE & INTERRUPTS
// ==============================================================================
// This section defines the processor core and interrupt controller.
// The STM32U575 uses an ARM Cortex-M33 core with NVIC for interrupt management.

// CPU Definition
// The main processor core that executes your program instructions
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"           // ARM Cortex-M33 with TrustZone and DSP extensions
    nvic: nvic                       // Link to the interrupt controller below

// NVIC (Nested Vectored Interrupt Controller)
// Manages all interrupts from peripherals (UART, timers, GPIO, etc.)
// When a peripheral needs attention, it sends an interrupt to NVIC, which
// then notifies the CPU based on priority levels
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 160000000     // SysTick timer runs at 160 MHz (CPU frequency)
    priorityMask: 0xF0              // 4-bit priority: 16 priority levels (0-15)
    IRQ -> cpu@0                    // Connect interrupt output to CPU input

// ==============================================================================
// 2. MEMORY REGIONS
// ==============================================================================
// Memory-mapped regions where your program code and data are stored.
// Each region has a specific address range and purpose.

// Flash Memory
// Non-volatile memory where your compiled program is stored (survives power loss)
// Address: 0x08000000 is the standard starting address for STM32 flash
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000 // 2MB (2,097,152 bytes)

// SRAM1 (Static RAM - Main working memory)
// Fast volatile memory for variables, stack, and heap during program execution
sram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x30000  // 192KB (196,608 bytes)

// SRAM2 (Additional RAM)
// Can be used for extra data storage or special purposes (e.g., DMA buffers)
sram2: Memory.MappedMemory @ sysbus 0x20030000
    size: 0x10000  // 64KB (65,536 bytes)

// SRAM3 (Largest RAM block)
// Additional high-capacity RAM for large data structures or buffers
sram3: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x80000  // 512KB (524,288 bytes)

// SRAM4 (Small dedicated RAM)
// Often used for special purposes like low-power operations
sram4: Memory.MappedMemory @ sysbus 0x28000000
    size: 0x4000   // 16KB (16,384 bytes)

// Backup SRAM
// Battery-backed RAM that retains data even when main power is lost
// Useful for storing critical data across resets
bkpsram: Memory.MappedMemory @ sysbus 0x40036400
    size: 0x2000   // 8KB (8,192 bytes)

// ==============================================================================
// 3. SYSTEM PERIPHERALS (MOCKED)
// ==============================================================================
// These are essential system-level peripherals. They're "mocked" here, meaning
// they exist as memory regions but don't provide full functionality in emulation.
// Your code can read/write to them without crashing, but complex features may
// not work exactly as on real hardware.

// RCC (Reset and Clock Control)
// Manages system clocks, peripheral clock enables, and reset functions
// Essential for turning on/off peripherals and configuring clock speeds
rcc: Memory.MappedMemory @ sysbus 0x46020C00
    size: 0x400

// PWR (Power Control)
// Controls power modes (sleep, stop, standby), voltage scaling, and power-related features
pwr: Memory.MappedMemory @ sysbus 0x46020800
    size: 0x400

// SYSCFG (System Configuration)
// Handles memory remapping, peripheral connections, and other system settings
syscfg: Memory.MappedMemory @ sysbus 0x46000400
    size: 0x400

// EXTI (External Interrupt/Event Controller)
// Manages external interrupts from GPIO pins (button presses, sensor signals, etc.)
exti: Memory.MappedMemory @ sysbus 0x46022000
    size: 0x400

// FMC (Flexible Memory Controller)
// Interface for external memory devices (SRAM, SDRAM, NOR/NAND Flash)
fmc: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x1000

// Flash Register Interface
// Control registers for flash memory operations (erase, program, option bytes)
// Different from the flash memory itself at 0x08000000
flash_reg: Memory.MappedMemory @ sysbus 0x40022000
    size: 0x400

// ==============================================================================
// 4. DMA CONTROLLERS (MOCKED)
// ==============================================================================
// DMA (Direct Memory Access) allows peripherals to transfer data to/from memory
// without CPU involvement, freeing the CPU for other tasks.
// This is critical for high-speed data transfers (e.g., ADC sampling, UART streams).

// GPDMA1 (General Purpose DMA)
// Main DMA controller for most peripherals
gpdma1: Memory.MappedMemory @ sysbus 0x40020000
    size: 0x1000

// LPDMA1 (Low Power DMA)
// DMA controller that can operate in low-power modes
// Size reduced to 0x400 to prevent memory overlap with SYSCFG
lpdma1: Memory.MappedMemory @ sysbus 0x46000000
    size: 0x400

// DMA2D (Chrom-Art Accelerator)
// Specialized DMA for graphics operations (pixel format conversion, blending)
// Used with displays and image processing
dma2d: Memory.MappedMemory @ sysbus 0x4002B000
    size: 0x1000

// ==============================================================================
// 5. ANALOG & MATH (MOCKED)
// ==============================================================================
// Peripherals for analog conversion, cryptography, and mathematical operations.

// CRC (Cyclic Redundancy Check)
// Hardware accelerator for calculating CRC checksums (data integrity verification)
crc: Memory.MappedMemory @ sysbus 0x40023000
    size: 0x400

// RNG (Random Number Generator)
// Hardware-based true random number generator (more secure than software PRNG)
rng: Memory.MappedMemory @ sysbus 0x420C0800
    size: 0x400

// ADC1 (Analog-to-Digital Converter 1)
// Converts analog voltages (0-3.3V) to digital values (0-4095 for 12-bit)
// Used for reading sensors: temperature, light, pressure, etc.
adc1: Memory.MappedMemory @ sysbus 0x42028000
    size: 0x400

// ADC4 (Analog-to-Digital Converter 4)
// Additional ADC, can operate in low-power modes
adc4: Memory.MappedMemory @ sysbus 0x46021000
    size: 0x400

// DAC1 (Digital-to-Analog Converter)
// Converts digital values to analog voltages
// Used for generating audio, control signals, or reference voltages
dac1: Memory.MappedMemory @ sysbus 0x46021800
    size: 0x400

// CORDIC (Coordinate Rotation Digital Computer)
// Hardware accelerator for trigonometric functions (sin, cos, atan, etc.)
// Much faster than software calculations
cordic: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x400

// FMAC (Filter Math Accelerator)
// Hardware accelerator for digital filters (IIR, FIR filters)
// Used in signal processing applications
fmac: Memory.MappedMemory @ sysbus 0x40021400
    size: 0x400

// HASH (Hash Processor)
// Hardware accelerator for cryptographic hash functions (SHA-256, etc.)
hash: Memory.MappedMemory @ sysbus 0x420C0400
    size: 0x400

// AES (Advanced Encryption Standard)
// Hardware accelerator for AES encryption/decryption
// Provides secure data encryption
aes: Memory.MappedMemory @ sysbus 0x420C0000
    size: 0x400

// PKA (Public Key Accelerator)
// Hardware accelerator for public-key cryptography (RSA, ECC)
pka: Memory.MappedMemory @ sysbus 0x420C2000
    size: 0x400

// ==============================================================================
// 6. CONNECTIVITY - UARTS (FUNCTIONAL)
// ==============================================================================
// UART/USART peripherals for serial communication. These are FULLY FUNCTIONAL
// in Renode, meaning you can send/receive text and binary data.
//
// UART = Universal Asynchronous Receiver/Transmitter (basic serial)
// USART = Universal Synchronous/Asynchronous Receiver/Transmitter (supports both modes)
//
// Common use cases: Debug output, GPS modules, Bluetooth modules, PC communication

// USART1 - Primary debug interface
// Connected to ST-LINK Virtual COM Port (shows up as USB serial on your PC)
// Default pins: PA9 (TX - Transmit), PA10 (RX - Receive)
// This is typically used for printf debugging
usart1: UART.STM32F7_USART @ sysbus <0x40013800, +0x400>
    frequency: 160000000            // Peripheral clock frequency (160 MHz)
    IRQ -> nvic@61                  // Interrupt number 61 for USART1 events

// USART2 - Additional serial port
usart2: UART.STM32F7_USART @ sysbus <0x40004400, +0x400>
    frequency: 160000000
    IRQ -> nvic@38                  // Interrupt number 38

// USART3 - Additional serial port
usart3: UART.STM32F7_USART @ sysbus <0x40004800, +0x400>
    frequency: 160000000
    IRQ -> nvic@39                  // Interrupt number 39

// UART4 - Basic UART (no synchronous mode)
uart4: UART.STM32F7_USART @ sysbus <0x40004C00, +0x400>
    frequency: 160000000
    IRQ -> nvic@52                  // Interrupt number 52

// UART5 - Basic UART
uart5: UART.STM32F7_USART @ sysbus <0x40005000, +0x400>
    frequency: 160000000
    IRQ -> nvic@53                  // Interrupt number 53

// LPUART1 (Low Power UART)
// Can operate in low-power modes when other UARTs cannot
// Useful for battery-powered applications
lpuart1: UART.STM32F7_USART @ sysbus <0x46002800, +0x400>
    frequency: 160000000
    IRQ -> nvic@66                  // Interrupt number 66

// ==============================================================================
// 7. CONNECTIVITY - SPI / I2C / USB / SDMMC (MOCKED)
// ==============================================================================
// Communication protocols for connecting external devices.
// These are mocked, so basic register access works, but full protocol
// implementation may not function exactly as on real hardware.

// SPI (Serial Peripheral Interface)
// Fast synchronous serial protocol for sensors, displays, SD cards
// Uses 4 wires: SCK (clock), MOSI (data out), MISO (data in), CS (chip select)
spi1: Memory.MappedMemory @ sysbus 0x40013000
    size: 0x400

spi2: Memory.MappedMemory @ sysbus 0x40003800
    size: 0x400

spi3: Memory.MappedMemory @ sysbus 0x46002000
    size: 0x400

// I2C (Inter-Integrated Circuit)
// Multi-device bus protocol using 2 wires: SDA (data), SCL (clock)
// Common for sensors, EEPROMs, real-time clocks
// Slower than SPI but needs fewer wires
i2c1: Memory.MappedMemory @ sysbus 0x40005400
    size: 0x400

i2c2: Memory.MappedMemory @ sysbus 0x40005800
    size: 0x400

i2c3: Memory.MappedMemory @ sysbus 0x46002400
    size: 0x400

i2c4: Memory.MappedMemory @ sysbus 0x40008400
    size: 0x400

// USB OTG FS (USB On-The-Go Full Speed)
// USB 2.0 Full Speed interface (12 Mbps)
// Can act as USB device or host
usb_otg_fs: Memory.MappedMemory @ sysbus 0x40040000
    size: 0x40000

// SDMMC (SD/MMC Card Interface)
// Interface for SD cards and eMMC flash memory
// Used for data logging and external storage
sdmmc1: Memory.MappedMemory @ sysbus 0x420C8000
    size: 0x400

sdmmc2: Memory.MappedMemory @ sysbus 0x420C8C00
    size: 0x400

// FDCAN1 (Flexible Datarate CAN)
// CAN bus interface for automotive and industrial communication
// Supports both classic CAN and CAN-FD (faster data rate)
fdcan1: Memory.MappedMemory @ sysbus 0x4000A400
    size: 0x400

// OctoSPI (Octal SPI)
// High-speed interface for external flash memory and PSRAM
// Supports up to 8 data lines for very fast transfers
octospi1: Memory.MappedMemory @ sysbus 0x42000400
    size: 0x400

octospi2: Memory.MappedMemory @ sysbus 0x42001400
    size: 0x400

// ==============================================================================
// 8. TIMERS (MOCKED)
// ==============================================================================
// Timers are versatile peripherals used for:
// - Generating PWM signals (motor control, LED dimming)
// - Measuring input signals (frequency counter, pulse width)
// - Creating precise time delays
// - Triggering periodic interrupts (task scheduling)

// TIM1 (Advanced Timer)
// 16-bit timer with advanced features: complementary PWM, dead-time insertion
// Ideal for motor control applications
tim1: Memory.MappedMemory @ sysbus 0x40012C00
    size: 0x400

// TIM2 (General Purpose Timer - 32-bit)
// 32-bit counter allows very long time periods
tim2: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x400

// TIM3, TIM4, TIM5 (General Purpose Timers)
// Standard 16-bit timers for PWM, input capture, and timing
tim3: Memory.MappedMemory @ sysbus 0x40000400
    size: 0x400

tim4: Memory.MappedMemory @ sysbus 0x40000800
    size: 0x400

tim5: Memory.MappedMemory @ sysbus 0x40000C00
    size: 0x400

// TIM6, TIM7 (Basic Timers)
// Simple timers typically used to trigger DAC or for basic timebase
tim6: Memory.MappedMemory @ sysbus 0x40001000
    size: 0x400

tim7: Memory.MappedMemory @ sysbus 0x40001400
    size: 0x400

// TIM8 (Advanced Timer)
// Similar to TIM1, another advanced timer for motor control
tim8: Memory.MappedMemory @ sysbus 0x40013400
    size: 0x400

// TIM15, TIM16, TIM17 (General Purpose Timers)
// Additional general-purpose timers
tim15: Memory.MappedMemory @ sysbus 0x40014000
    size: 0x400

tim16: Memory.MappedMemory @ sysbus 0x40014400
    size: 0x400

tim17: Memory.MappedMemory @ sysbus 0x40014800
    size: 0x400

// LPTIM (Low Power Timers)
// Can run in low-power modes when CPU is sleeping
// Used for waking the system or maintaining time in sleep mode
lptim1: Memory.MappedMemory @ sysbus 0x46004400
    size: 0x400

lptim2: Memory.MappedMemory @ sysbus 0x40009400
    size: 0x400

lptim3: Memory.MappedMemory @ sysbus 0x46004800
    size: 0x400

lptim4: Memory.MappedMemory @ sysbus 0x46004C00
    size: 0x400

// IWDG (Independent Watchdog)
// Hardware watchdog timer that resets the system if not periodically refreshed
// Prevents system lockups (if your program crashes, watchdog resets it)
iwdg: Memory.MappedMemory @ sysbus 0x40003000
    size: 0x400

// WWDG (Window Watchdog)
// Similar to IWDG but must be refreshed within a specific time window
wwdg: Memory.MappedMemory @ sysbus 0x40002C00
    size: 0x400

// RTC (Real-Time Clock)
// Keeps track of date and time, even when CPU is sleeping
// Powered by backup battery or capacitor
rtc: Memory.MappedMemory @ sysbus 0x46007800
    size: 0x400

// TAMP (Tamper and Backup Registers)
// Detects tampering attempts (pin manipulation, voltage glitches)
// Stores data in tamper-proof backup registers
tamp: Memory.MappedMemory @ sysbus 0x46007C00
    size: 0x400

// ==============================================================================
// 9. GPIO PORTS (FUNCTIONAL)
// ==============================================================================
// GPIO (General Purpose Input/Output) pins are the "physical connections" of
// the microcontroller. Each pin can be configured as:
// - Digital Output: Turn LEDs on/off, control relays, send signals
// - Digital Input: Read buttons, switches, sensor signals
// - Alternate Function: UART, SPI, I2C, PWM, etc.
// - Analog Input: Connect to ADC for sensor readings
//
// The STM32U575 has 9 GPIO ports (A-I), each with up to 16 pins.
// Base address for all GPIO: 0x42020000 (AHB2 bus)

// GPIO Port A
// Contains USART1 pins: PA9 (USART1_TX), PA10 (USART1_RX)
// Often used for communication and alternate functions
gpioA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    numberOfAFs: 16                 // Each pin can have up to 16 alternate functions

// GPIO Port B
// Contains Blue User LED on PB7
// Pin PB7 is connected to the onboard blue LED
gpioB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    numberOfAFs: 16
    7 -> UserLED_Blue@0             // Pin 7 controls the blue LED

// GPIO Port C
// Contains Green User LED on PC7
// Pin PC7 is connected to the onboard green LED
gpioC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    numberOfAFs: 16
    7 -> UserLED_Green@0            // Pin 7 controls the green LED

// GPIO Port D
// General-purpose I/O pins
gpioD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16

// GPIO Port E
// General-purpose I/O pins
gpioE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16

// GPIO Port F
// General-purpose I/O pins
gpioF: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>
    numberOfAFs: 16

// GPIO Port G
// Contains Red User LED on PG2
// Pin PG2 is connected to the onboard red LED
gpioG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16
    2 -> UserLED_Red@0              // Pin 2 controls the red LED

// GPIO Port H
// General-purpose I/O pins
gpioH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    numberOfAFs: 16

// GPIO Port I
// General-purpose I/O pins
gpioI: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>
    numberOfAFs: 16

// ==============================================================================
// 10. VISUALIZATION
// ==============================================================================
// These LED objects provide visual feedback in the Renode GUI.
// You can watch them turn on/off when your program controls the GPIO pins.
//
// LED Control Example:
//   Set pin HIGH (1) -> LED turns ON
//   Set pin LOW (0)  -> LED turns OFF
//
// Board LED Mapping:
//   - Green LED (LD1): PC7 - Often used for "program running" indicator
//   - Blue LED (LD2):  PB7 - Often used for "activity" indicator
//   - Red LED (LD3):   PG2 - Often used for "error" indicator

UserLED_Green: Miscellaneous.LED @ gpioC 7
UserLED_Blue: Miscellaneous.LED @ gpioB 7
UserLED_Red: Miscellaneous.LED @ gpioG 2

// ==============================================================================
// END OF PLATFORM DESCRIPTION
// ==============================================================================
// This completes the STM32U575ZI-Q platform definition. To use this file:
// 1. Load it in Renode: mach create "stm32u575"
// 2. Load this file: machine LoadPlatformDescription @path/to/this/file.repl
// 3. Load your firmware: sysbus LoadELF @path/to/your/firmware.elf
// 4. Start emulation: start
//
// Happy coding and debugging!
// ==============================================================================